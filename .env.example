# --- Supabase (from Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=            # "Project URL"
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # "anon public" key — safe for browser
SUPABASE_SERVICE_ROLE_KEY=           # "service_role" key — SERVER ONLY, never expose to client

# --- Encryption (Sprint 1-2 non-negotiable, used for broker API keys later) ---
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

